# ── env.example ──────────────────────────────────────────────────────────────
# Copy this to .env and fill in your keys.
# NEVER commit .env to version control.

# ── LLM (Groq - free tier) ────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Groq free models - check https://console.groq.com/docs/models for current list
GROQ_MODEL_GENERATOR=llama-3.3-70b-versatile
GROQ_MODEL_VERIFIER=gemma2-9b-it
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# ── Optional LLM extras ───────────────────────────────────────────────────────
# LLM_CHAIN: comma-separated chain, e.g. "groq,gemini" or "groq,ollama"
LLM_CHAIN=groq
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Vector DB (Pinecone Starter - free) ───────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=studycompanion
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# local | pinecone
VECTOR_BACKEND=local

# ── OCR ───────────────────────────────────────────────────────────────────────
# freeocr.ai: sign up at https://freeocr.ai/platform/keys  (get ~.01 free credit = ~5 calls)
FREEOCR_API_KEY=
FREEOCR_MAX_CALLS=5
# freeocr | tesseract
OCR_PROVIDER=tesseract

# ── Sarvam AI (STT/TTS/Translate - Indian languages) ─────────────────────────
# Sign up at https://dashboard.sarvam.ai/  Free credits vary; check dashboard.
SARVAM_API_KEY=
# Hard budget cap in INR - default set well inside the free credit allowance
SARVAM_BUDGET_INR=10.0
# Per-unit rates (read from env so you can update without code changes)
# Source: https://www.sarvam.ai/pricing  (verify current prices)
SARVAM_RATE_STT_PER_HOUR=0.0       # rate in INR per audio-hour; set 0 if free
SARVAM_RATE_TTS_PER_10K_CHARS=0.0  # rate in INR per 10K characters; set 0 if free
SARVAM_RATE_TRANSLATE_PER_10K_CHARS=0.0

# ── ElevenLabs (Free Tier) ────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_FEMALE=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_MALE=JBFqnCBsd6RMkjVDRZzb

# ── Provider selection ────────────────────────────────────────────────────────
# sarvam | faster-whisper
QA_STT_PROVIDER=faster-whisper
# Always local for long lecture ingestion
INGEST_STT_PROVIDER=faster-whisper
# elevenlabs | sarvam | edge | gtts
TTS_PROVIDER=elevenlabs
# sarvam | llm
TRANSLATE_PROVIDER=llm

# ── LLM rate limits (token bucket) ───────────────────────────────────────────
# Groq free tier: check https://console.groq.com/docs/rate-limits for current limits
GROQ_RATE_LIMIT_RPM=30
GROQ_RATE_LIMIT_TPM=6000
GROQ_CONCURRENCY=5
GEMINI_RATE_LIMIT_RPM=15
GEMINI_CONCURRENCY=3
OLLAMA_CONCURRENCY=2

# ── Budget mode ───────────────────────────────────────────────────────────────
# normal | saver  (saver skips optional LLM steps)
BUDGET_MODE=normal

# ── Cache ─────────────────────────────────────────────────────────────────────
LLM_CACHE_DIR=data/llm_cache

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=sqlite:///./data/studycompanion.db

# ── Storage ───────────────────────────────────────────────────────────────────
DATA_DIR=data
MAX_UPLOAD_MB=200

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32

# ── Whisper (local, via faster-whisper) ───────────────────────────────────────
# tiny | base | small | medium  (base is a good CPU default)
WHISPER_MODEL=base

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
